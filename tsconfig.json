{
  "compilerOptions": {
    "target": "esnext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": false,
    "rootDir": ".",
    "outDir": "./dist",
    "noEmit": true,
    "incremental": false
  },
  "include": ["src/**/*", "test/**/*", "e2e/**/*"]
}
